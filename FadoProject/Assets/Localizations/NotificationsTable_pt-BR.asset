  m_Name: NotificationsTable_pt-BR
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 18e28a33ae02c9942a5db6b5c19629a0, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: "Oh n\xE3o! Algu\xE9m te silenciou por {0} turno{1}..."
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: Sintomas surgiram, as suas vozes foram silenciadas por {0} turno{1}...
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "Parece que algu\xE9m n\xE3o gostou do que voc\xEA exp\xF4s. Voc\xEA
      foi silenciado por {0} turno{1}."
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "O M\xE9dico lhe concedeu uma prote\xE7\xE3o medicinal por {0} turno{1}."
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "O seu voto est\xE1 diferente do que votou...? Algu\xE9m manipulou
      os seus votos!"
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Algu\xE9m te ajudou, e adicionou {0} de {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "Ora, parece que voc\xEA recebeu os benef\xEDcios de algu\xE9m,
      resultando no aumento de {1} por {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "Parece que algu\xE9m n\xE3o est\xE1 gostando de voc\xEA... Algu\xE9m
      tirou {0} de {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "Algu\xE9m est\xE1 espalhando mentiras sobre voc\xEA... {0} a menos
      de {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "Infelizmente, nem todas as pessoas gostam de voc\xEA, e aplicou
      {0} de veneno..."
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "Voc\xEA acordou com uma sensa\xE7\xE3o estranha, o que fez perceber
      que algu\xE9m o envenenou. Recebe {0} de veneno."
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "Voc\xEA percebe que sua vis\xE3o est\xE1 turva, e ent\xE3o voc\xEA
      descobre que foi envenenado. Recebe {0} de veneno."
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "As m\xE3os mal\xEDgnas do corrupto deixou claros rastros de destrui\xE7\xE3o.
      Foi envenenado por {0} de veneno."
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "O m\xE9dico fez um \xF3timo trabalho e conseguiu desintoxicar {0}
      de veneno de voc\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "O m\xE9dico mostrou a sua habilidade surpreendente, e retirou do
      seu corpo {0} de veneno."
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "Ah n\xE3o, algu\xE9m o corrompeu! A corrup\xE7\xE3o o corrompeu
      em {0}..."
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "Algu\xE9m salvou voc\xEA, o seu n\xEDvel de corrup\xE7\xE3o diminuiu
      em {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "O poder maligno da corrup\xE7\xE3o impossibilitou de voc\xEA tomar
      a\xE7\xF5es por {0} turno{1}."
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "A manh\xE3 foi aterrorizante, marcado por movimenta\xE7\xF5es limitados
      do seu corpo. Voc\xEA foi impossibilitado em tomar a\xE7\xF5es por {0} turno{1}."
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "O seu corpo n\xE3o est\xE1 obedecendo as suas vontades. Parece
      que algu\xE9m o paralizou por {0} turno{1}."
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "Algu\xE9m n\xE3o est\xE1 gostando das suas escolhas e impossibilitou
      de voc\xEA votar por {0} turno{1}."
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "Infelizmente, algu\xE9m retirou o seu direito de votar por {0}
      turno{1}."
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: "Uma purifica\xE7\xE3o sublime percorreu pelo seu corpo, anulando
      todos os efeitos malignos da corrup\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "O poder dos esp\xEDritos mostrou o seu poder imensur\xE1vel e anulou
      todos os efeitos malignos da corrup\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: Rodada
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: '{0} recebeu {1} voto(s)\n'
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "{0} foi eliminado da mesa de negocia\xE7\xF5es."
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "{0} foi enviado ao obl\xEDvio, deixando para tr\xE1s apenas arrependimentos."
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: "{0} alcan\xE7ou um destino infeliz."
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "{0} teve seus gritos de desespero abafados na pris\xE3o, em meio
      ao fim doloroso e sofrido que encontrou, como muitos outros antes e depois
      dele."
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "{0} teve um fim prematuro dado a seus sonhos e esperan\xE7as."
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: "Neste teatro cruel, {0} assumiu o papel de v\xEDtima em uma conspira\xE7\xE3o
      fatal."
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: "{0} foi enviado para o al\xE9m, restando apenas as mem\xF3rias
      deixadas para tr\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 22205784718381056
    m_Localized: "Voc\xEA revelou com sucesso o jogador {0}. A pessoa \xE9 {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 44880959006191616
    m_Localized: "Voc\xEA n\xE3o consegui resolver o puzzle a tempo, mais sorte na
      proxima vez."
    m_Metadata:
      m_Items: []
