  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 18e28a33ae02c9942a5db6b5c19629a0, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: "\xA1Oh no! Alguien te ha silenciado por {0} turno{1}..."
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "Han surgido s\xEDntomas, tus voces han sido silenciadas por {0}
      turno{1}..."
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "Parece que a alguien no le gust\xF3 lo que expusiste. Has sido
      silenciado por {0} turno{1}."
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "El M\xE9dico te ha concedido una protecci\xF3n medicinal por {0}
      turno{1}."
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "\xBFTu voto es diferente al que emitiste...? \xA1Alguien ha manipulado
      tus votos!"
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Alguien te ayud\xF3 y a\xF1adi\xF3 {0} de {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: Bueno, parece que recibiste los beneficios de alguien, resultando
      en un aumento de {1} por {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: Parece que a alguien no le agradas... Alguien ha quitado {0} de
      {1}.
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "Alguien est\xE1 difundiendo mentiras sobre ti... {0} menos de {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: Desafortunadamente, no a todos les agradas, y aplicaron {0} de veneno...
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "Te despertaste con una sensaci\xF3n extra\xF1a, lo que te hizo
      darte cuenta de que alguien te envenen\xF3. {0} de veneno."
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "Te das cuenta de que tu visi\xF3n est\xE1 borrosa, y luego descubres
      que has sido envenenado por {0} de veneno."
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "Las manos malignas del corrupto dejaron claros rastros de destrucci\xF3n.
      Has sido envenenado por {0} de veneno."
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "El m\xE9dico hizo un gran trabajo y logr\xF3 desintoxicar {0} de
      veneno de ti."
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "El m\xE9dico mostr\xF3 su habilidad sorprendente y elimin\xF3 {0}
      de veneno de tu cuerpo."
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "\xA1Oh no, alguien te ha corrompido! La corrupci\xF3n te ha corrompido
      en {0}..."
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "Alguien te salv\xF3, tu nivel de corrupci\xF3n ha disminuido en
      {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "El poder maligno de la corrupci\xF3n te ha impedido tomar acciones
      por {0} turno{1}."
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "La ma\xF1ana fue aterradora, marcada por movimientos limitados
      de tu cuerpo. Has sido impedido de tomar acciones por {0} turno{1}."
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: Tu cuerpo no obedece a tu voluntad. Parece que alguien te ha paralizado
      por {0} turno{1}.
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: A alguien no le gustan tus elecciones y te ha impedido votar por
      {0} turno{1}.
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: Desafortunadamente, alguien ha revocado tu derecho a votar por {0}
      turno{1}.
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: "Una purificaci\xF3n sublime recorri\xF3 tu cuerpo, anulando todos
      los efectos malignos de la corrupci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "El poder de los esp\xEDritus mostr\xF3 su fuerza inconmensurable
      y anul\xF3 todos los efectos malignos de la corrupci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: Ronda
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: "{0} recibi\xF3 {1} voto(s)\\n"
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: '{0} fue eliminado de la mesa de negociaciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "{0} fue enviado al olvido, dejando atr\xE1s solo arrepentimientos."
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: "{0} alcanz\xF3 un destino desafortunado."
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "{0} tuvo sus gritos de desespero ahogados en la prisi\xF3n, en
      medio del fin doloroso y agonizante que encontr\xF3, como muchos otros antes
      y despu\xE9s de \xE9l."
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "{0} tuvo un fin prematuro de sus sue\xF1os y esperanzas."
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: "En este cruel teatro, {0} asumi\xF3 el papel de v\xEDctima en una
      conspiraci\xF3n fatal."
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: "{0} fue enviado al m\xE1s all\xE1, dejando atr\xE1s solo recuerdos."
    m_Metadata:
      m_Items: []
  - m_Id: 22205784718381056
    m_Localized: "Has revelado con \xE9xito al jugador {0}, la persona es {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 44880959006191616
    m_Localized: "No resolviste el rompecabezas lo suficientemente r\xE1pido, tal
      vez la pr\xF3xima vez."
    m_Metadata:
      m_Items: []
  references:
